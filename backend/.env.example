# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:2202

# Database
MONGODB_URI=mongodb://localhost:27017/chatbot-platform

# Redis (for queues & caching)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# Facebook OAuth (required for Messenger/Instagram connection and ad JSON receiving_app_id)
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
# Facebook Login for Business config_id — create under App Dashboard > Facebook Login for Business > Configurations
FB_LOGIN_CONFIG_ID=your-login-configuration-id
BACKEND_URL=http://localhost:4000

# Facebook Messenger API
# Webhook callback URL: {BACKEND_URL}/webhook/messenger
# Page access tokens are normally saved per Channel, but this remains for local fallback.
FB_PAGE_ACCESS_TOKEN=your-fb-page-access-token
FB_VERIFY_TOKEN=verify-token-2026

# File Upload (optional, for images in flows)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
